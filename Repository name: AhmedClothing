            "Phone: " + customer["phone"] + "\n\n"
            "Clothes: " + customer["clothes"] + "\n\n"
            "Price: ₦" + str(customer["price"]) + "\n\n"
            "Deposit: ₦" + str(customer["deposit"]) + "\n\n"
            "Balance: ₦" + str(customer["balance"]) + "\n\n"
            "Payment: " + customer["payment"]
        )

        label = Label(
            text=text,
            font_size=sp(19),
            halign="left",
            valign="top"
        )

        self.layout.add_widget(label)

        back = self.make_button(
            "BACK",
            self.show_search
        )

        self.layout.add_widget(back)

